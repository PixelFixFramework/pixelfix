# =====================================================
# PIXELFIX APPLICATION ENVIRONMENT
# =====================================================
# Copy this file to .env (or run the application's setup-environment.php
# script) and adjust the values for your machine/deployment.
#
# Keep .env out of version control. Never commit production passwords,
# tokens, or other secrets.
#
# Boolean values accept true/false. Use the literal null where a null value
# is intended. Blank values are still empty strings; they do not always mean
# "use the default".

# =====================================================
# APPLICATION
# =====================================================

# Human-readable application name; also used as the default mail sender name.
APP_NAME='PixelFix Application'

# Environment name used by environment-aware framework behavior.
# Common values: local, testing, staging, production.
APP_ENV=local

# Enables detailed debugging (including Twig debug mode). Set false in production.
APP_DEBUG=true

# Canonical base URL used when generating absolute application links.
APP_URL=http://127.0.0.1:8000

# Application base-path value exposed through config('app.base_path').
# Use / when the application is served from the web root; adjust for a sub-path.
APP_BASE_PATH=/

# PHP/application timezone. Use a valid IANA timezone identifier.
TIMEZONE=Africa/Lusaka

# =====================================================
# VIEWS
# =====================================================

# Exposes the app_debug flag to templates (separate from APP_DEBUG).
# Keep false unless a template specifically needs the debug flag.
TWIG_DEBUG=false

# =====================================================
# UI NOTIFICATIONS / DIALOGS
# =====================================================

# UI driver used by the generated application layout: toastr or zebra.
UI_DRIVER=zebra

# Zebra Dialog theme; only used when UI_DRIVER=zebra.
# Supported themes: classic, flat, materialize.
UI_ZEBRA_THEME=classic

# =====================================================
# DATABASE
# =====================================================

# Name of the default connection in config/database.php.
# Supported drivers: mysql, mariadb, pgsql, sqlite, sqlsrv, dblib, mongodb.
# SQLite is the default for a new local application; select another driver
# only after configuring that database service and its credentials below.
DB_CONNECTION=sqlite

# Named connections are configured by adding entries under "connections" in
# config/database.php. Each entry may read its own environment variables.
# The variable names are application-defined; see the optional REPORTING_DB_*
# examples at the end of this section. Use db()->onConnection('reporting') (or
# the model connection setting) only after adding that named configuration.

# =====================================================
# MYSQL (used when DB_CONNECTION=mysql)
# =====================================================

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# =====================================================
# MARIADB (used when DB_CONNECTION=mariadb)
# =====================================================

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# =====================================================
# POSTGRESQL (used when DB_CONNECTION=pgsql)
# =====================================================

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=
PGSQL_USER=postgres
PGSQL_PASSWORD=

# =====================================================
# SQLITE (used when DB_CONNECTION=sqlite)
# =====================================================

# Relative paths resolve from the application root. The parent directory is
# created by the framework when needed. Use :memory: only for transient data.
SQLITE_DATABASE=database/database.sqlite

# =====================================================
# MICROSOFT SQL SERVER (used when DB_CONNECTION=sqlsrv)
# =====================================================

SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=
SQLSRV_USER=
SQLSRV_PASSWORD=

# =====================================================
# DBLIB / FREETDS (used when DB_CONNECTION=dblib)
# =====================================================

DBLIB_HOST=127.0.0.1
DBLIB_PORT=1433
DBLIB_DATABASE=
DBLIB_USER=
DBLIB_PASSWORD=

# =====================================================
# MONGODB (used when DB_CONNECTION=mongodb)
# =====================================================

# MongoDB extension/library requirements apply; see the framework package notes.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=

# Optional named MySQL connection example. Uncomment these only after adding a
# matching "reporting" entry to config/database.php. Rename the prefix as needed.
# REPORTING_DB_HOST=127.0.0.1
# REPORTING_DB_PORT=3306
# REPORTING_DB_DATABASE=reporting
# REPORTING_DB_USER=
# REPORTING_DB_PASSWORD=

# =====================================================
# FILESYSTEM / STORAGE
# =====================================================

# Default disk name from config/filesystems.php: local or public by default.
# Use local for ordinary/private files; use public only for files intended to
# be served to browsers. Add custom disks in config/filesystems.php if needed.
FILESYSTEM_DISK=local

# The public disk is mapped to /storage by default. Create the configured link
# after setup/deployment with: php pixel storage:link

# =====================================================
# PDF AND SPREADSHEET EXPORTS (OPTIONAL PACKAGES)
# =====================================================

# Install PDF support with: composer require dompdf/dompdf
# PDF paper size (for example A4, A3, Letter) and page orientation.
PDF_PAPER=A4
PDF_ORIENTATION=portrait

# Character encoding and default font used for generated PDF documents.
PDF_ENCODING=UTF-8
PDF_DEFAULT_FONT='DejaVu Sans'

# Rendering DPI (36-600). Larger values may increase output size and render time.
PDF_DPI=96

# Keep false unless trusted templates need remote images/stylesheets.
# Enabling remote assets can expose the server to SSRF and unsafe URL access.
PDF_REMOTE_ENABLED=false

# Install spreadsheet support with: composer require phpoffice/phpspreadsheet
# Output format: xlsx, xls, csv, or ods.
SPREADSHEET_FORMAT=xlsx
SPREADSHEET_SHEET_NAME=Sheet1
SPREADSHEET_AUTO_SIZE_COLUMNS=false
SPREADSHEET_HEADER_BOLD=true

# =====================================================
# SESSION
# =====================================================

# Currently supported session driver: file.
SESSION_DRIVER=file

# Session cookie lifetime in minutes; the default is two hours.
SESSION_LIFETIME=120

# Browser cookie and PHP session name. Configure this here; there is no separate
# SESSION_NAME option.
SESSION_COOKIE=pixelfix_session

# Cookie path and optional domain. Leave the domain blank for the current host.
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=

# Set true when the application is served exclusively over HTTPS.
SESSION_COOKIE_SECURE=false

# Prevent JavaScript access to the session cookie; keep true for normal apps.
SESSION_COOKIE_HTTP_ONLY=true

# SameSite options: Strict, Lax, or None. None requires Secure=true in browsers.
SESSION_COOKIE_SAME_SITE=Lax

# End session when the browser closes instead of using the lifetime above.
SESSION_EXPIRE_ON_CLOSE=false


# =====================================================
# AUTHENTICATION
# =====================================================

# Remember-me cookie name and duration (duration is in seconds).
AUTH_REMEMBER_COOKIE=pixelfix_remember
AUTH_REMEMBER_DURATION=2592000

# =====================================================
# SECURITY / PASSWORD RESET
# =====================================================

# Enable cross-site request forgery checks for state-changing web requests.
CSRF_ENABLED=true

# Password reset token validity period in minutes.
PASSWORD_RESET_EXPIRE=60

# Minimum seconds before another password-reset request may be issued.
PASSWORD_RESET_THROTTLE=60

# =====================================================
# LOGGING
# =====================================================

# Minimum level emitted by framework logging: debug, info, warning, error.
LOG_LEVEL=debug

# =====================================================
# MAIL
# =====================================================

# Currently supported mail driver: smtp. SMTP credentials are intentionally
# empty in this example; configure them before using email delivery.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# SMTP encryption: tls (common with port 587), ssl (commonly port 465), or none.
MAIL_ENCRYPTION=tls

# SMTP connect/read timeout in seconds.
MAIL_TIMEOUT=10

# Sender address must be configured with a valid address for the mail provider.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME='PixelFix Application'

# =====================================================
# CACHE
# =====================================================

# Supported cache drivers: file or array. Array cache is not persistent.
CACHE_DRIVER=file

# Leave blank to use storage/cache/data. Set a path to override the default.
CACHE_PATH=

# Supported lock driver: array (also accepted: auto). Array locks are process-local.
CACHE_LOCK_DRIVER=array

# =====================================================
# RATE LIMITING
# =====================================================

# Prefix for cache keys used by rate limiters; change to isolate applications
# that share the same cache backend.
RATE_LIMIT_PREFIX=rate_limit:

# Maximum failed login attempts before throttling.
AUTH_LOGIN_MAX_ATTEMPTS=5

# Login throttle decay window in seconds.
AUTH_LOGIN_DECAY_SECONDS=60

# =====================================================
# SCHEDULING
# =====================================================

# Timezone used by the scheduler. Defaults to TIMEZONE when not specified.
SCHEDULER_TIMEZONE=Africa/Lusaka

# These options apply only when the application registers a schedule named
# "reminders". The schedule is disabled by default; enable it only when needed.
SCHEDULE_REMINDERS_ENABLED=false

# Reminder cadence: daily, or hourly between START_HOUR and END_HOUR.
SCHEDULE_REMINDERS_FREQUENCY=daily

# 24-hour clock, inclusive hour range used by hourly reminder schedules.
SCHEDULE_REMINDERS_START_HOUR=8
SCHEDULE_REMINDERS_END_HOUR=23

# =====================================================
# QUEUE
# =====================================================

# Queue connection: sync (default, immediate execution), database, or redis.
# Database/Redis queues need the matching storage service and worker configured.
QUEUE_CONNECTION=sync

# Defer dispatch until the active database transaction commits, where applicable.
QUEUE_AFTER_COMMIT=false

# Seconds before an unacknowledged job becomes eligible for retry.
QUEUE_RETRY_AFTER=90

# Table names used by the database queue and failed/dead-letter job storage.
QUEUE_DATABASE_TABLE=jobs
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_DEAD_LETTER_TABLE=dead_letter_jobs

# Named Redis connection configured in config/redis.php; defaults to "default".
QUEUE_REDIS_CONNECTION=default

# Key prefix for the Redis queue driver.
QUEUE_REDIS_PREFIX=queues:

# Comma-separated queues started automatically by `php pixelfix dev` when using
# the database or Redis queue driver. The --queues option overrides this value.
WORKER_QUEUES=default

# =====================================================
# NOTIFICATIONS
# =====================================================

# Comma-separated default channels: database, mail, broadcast, or app-defined
# custom channels. Configure each selected delivery channel before using it.
NOTIFICATIONS_CHANNELS=database

# Database table used by the database notification channel.
NOTIFICATIONS_TABLE=notifications

# =====================================================
# BROADCASTING
# =====================================================

# Currently supported broadcast driver: redis. Configure Redis below.
BROADCAST_DRIVER=redis

# Prefix for Redis broadcasting pub/sub channels.
BROADCAST_REDIS_PREFIX=broadcast:

# =====================================================
# REDIS
# =====================================================

# Default named Redis connection; the Redis config can define additional ones.
REDIS_CONNECTION=default

# Redis connection used for publishing/subscribing to broadcast messages.
REDIS_PUBSUB_CONNECTION=default

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Redis logical database index (zero-based).
REDIS_DB=0

# Connect timeout in seconds.
REDIS_TIMEOUT=2.5

# Enable persistent Redis connections when supported by the PHP Redis client.
REDIS_PERSISTENT=false
REDIS_PERSISTENT_ID=pixelfix

# Optional read timeout in seconds. Use null for the Redis client's default.
REDIS_READ_TIMEOUT=null

# =====================================================
# BROWSER BROADCASTING / WEBSOCKETS (OPT-IN)
# =====================================================

# Disabled by default. Enable only after configuring a WebSocket service and
# permitted origins for the application.
WEBSOCKETS_ENABLED=false

# WebSocket server bind address and port.
WEBSOCKETS_HOST=127.0.0.1
WEBSOCKETS_PORT=8080

# Comma-separated allowed browser origins, for example https://app.example.com.
# An empty list allows the server's configured/default behavior; configure this
# explicitly for internet-facing deployments.
WEBSOCKETS_ALLOWED_ORIGINS=

# Maximum frame size and handshake size in bytes.
WEBSOCKETS_MAX_FRAME_SIZE=1048576
WEBSOCKETS_MAX_HANDSHAKE_SIZE=16384

# Internal relay listener port and maximum message size in bytes.
WEBSOCKETS_RELAY_PORT=8091
WEBSOCKETS_RELAY_MAX_BYTES=1048576