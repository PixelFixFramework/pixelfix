# =====================================================
# APPLICATION
# =====================================================

APP_NAME='PixelFix Application'
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_BASE_PATH=
TIMEZONE=Africa/Lusaka

# =====================================================
# VIEWS
# =====================================================

TWIG_DEBUG=false

# =====================================================
# UI
# =====================================================

UI_DRIVER=zebra
# Zebra Dialog theme: classic, flat, or materialize
UI_ZEBRA_THEME=classic

# =====================================================
# DATABASE
# =====================================================

# Supported drivers:
#
# mysql
# mariadb
# pgsql
# sqlite
# sqlsrv
# dblib
# mongodb

DB_CONNECTION=sqlite

# =====================================================
# MYSQL
# =====================================================

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# =====================================================
# MARIADB
# =====================================================

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# =====================================================
# POSTGRESQL
# =====================================================

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=
PGSQL_USER=postgres
PGSQL_PASSWORD=

# =====================================================
# SQLITE
# =====================================================

# Path to the SQLite database file.
#
# Examples:
#
# database/database.sqlite
# :memory:

SQLITE_DATABASE=database/database.sqlite

# =====================================================
# SQL SERVER
# =====================================================

SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=
SQLSRV_USER=
SQLSRV_PASSWORD=

# =====================================================
# DBLIB
# =====================================================

DBLIB_HOST=127.0.0.1
DBLIB_PORT=1433
DBLIB_DATABASE=
DBLIB_USER=
DBLIB_PASSWORD=

# =====================================================
# MONGODB
# =====================================================

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=

# =====================================================
# SESSION
# =====================================================

SESSION_DRIVER=file
SESSION_NAME=pixelfix_session
SESSION_COOKIE=pixelfix_session
SESSION_LIFETIME=120

SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Lax

SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false

# =====================================================
# AUTHENTICATION
# =====================================================

AUTH_REMEMBER_COOKIE=pixelfix_remember
AUTH_REMEMBER_DURATION=2592000

# =====================================================
# SECURITY
# =====================================================

CSRF_ENABLED=true
PASSWORD_RESET_EXPIRE=60
PASSWORD_RESET_THROTTLE=60

# =====================================================
# LOGGING
# =====================================================

LOG_LEVEL=debug

# =====================================================
# MAIL
# =====================================================

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PIXELFIX

# =====================================================
# CACHE
# =====================================================

CACHE_DRIVER=file
CACHE_PATH=
CACHE_LOCK_DRIVER=array

# =====================================================
# RATE LIMITING
# =====================================================

RATE_LIMIT_PREFIX=rate_limit:
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60

# =====================================================
# SCHEDULING
# =====================================================

SCHEDULER_TIMEZONE=Africa/Lusaka

# Generic options for the application-registered schedule named "reminders".
# daily: once at SCHEDULE_REMINDERS_START_HOUR in SCHEDULER_TIMEZONE.
# hourly: every hour from SCHEDULE_REMINDERS_START_HOUR through SCHEDULE_REMINDERS_END_HOUR.
#
# DEFAULT: disabled.
# Enable this only when the application registers and needs the reminders schedule.
SCHEDULE_REMINDERS_ENABLED=false
SCHEDULE_REMINDERS_FREQUENCY=daily
SCHEDULE_REMINDERS_START_HOUR=8
SCHEDULE_REMINDERS_END_HOUR=23

# =====================================================
# QUEUE
# =====================================================

# DEFAULT: sync.
# Jobs execute immediately; a database queue and separate worker are not
# required by default. Select "database" or another supported connection
# when the application needs asynchronous job processing.
QUEUE_CONNECTION=sync
QUEUE_AFTER_COMMIT=false
QUEUE_RETRY_AFTER=90
QUEUE_DATABASE_TABLE=jobs
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_DEAD_LETTER_TABLE=dead_letter_jobs
QUEUE_REDIS_CONNECTION=default
QUEUE_REDIS_PREFIX=queues:

# =====================================================
# NOTIFICATIONS
# =====================================================

# Comma-separated default delivery channels: database, mail, broadcast, or
# custom channels.
#
# DEFAULT: database only.
# Add mail after configuring SMTP. Add broadcast when the application has
# configured and requires a broadcasting service.
NOTIFICATIONS_CHANNELS=database
NOTIFICATIONS_TABLE=notifications

# =====================================================
# BROADCASTING
# =====================================================

BROADCAST_DRIVER=redis
BROADCAST_REDIS_PREFIX=broadcast:

# =====================================================
# REDIS
# =====================================================

REDIS_CONNECTION=default
REDIS_PUBSUB_CONNECTION=default
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2.5
REDIS_PERSISTENT=false
REDIS_PERSISTENT_ID=pixelfix
REDIS_READ_TIMEOUT=

# =====================================================
# BROWSER BROADCASTING / WEBSOCKETS (OPT-IN)
# =====================================================

# DEFAULT: disabled.
# Enable only when the application requires browser-based broadcasting
# through a WebSocket server and the required services are configured.
WEBSOCKETS_ENABLED=false
WEBSOCKETS_HOST=127.0.0.1
WEBSOCKETS_PORT=8080
WEBSOCKETS_ALLOWED_ORIGINS=
WEBSOCKETS_MAX_FRAME_SIZE=1048576
WEBSOCKETS_MAX_HANDSHAKE_SIZE=16384
WEBSOCKETS_RELAY_PORT=8091
WEBSOCKETS_RELAY_MAX_BYTES=1048576