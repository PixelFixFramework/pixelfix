                                </div>

                            </div>


                            <div class="col-sm-6">

                                <div class="d-flex gap-3">

                                    <i
                                        class="
                                            bi
                                            bi-boxes
                                            text-primary
                                            fs-4
                                        "
                                    ></i>

                                    <div>

                                        <h6 class="fw-bold mb-1">
                                            Reusable
                                        </h6>

                                        <p class="small text-secondary mb-0">
