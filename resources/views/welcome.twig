                                d-flex
                                flex-wrap
                                gap-4
                                text-secondary
                            "
                        >

                            <div class="d-flex align-items-center gap-2">

                                <i
                                    class="
                                        bi
                                        bi-check-circle-fill
                                        text-primary
                                    "
                                ></i>

                                <span>
                                    Clean architecture
                                </span>

                            </div>


                            <div class="d-flex align-items-center gap-2">

                                <i
                                    class="
                                        bi
                                        bi-check-circle-fill
                                        text-primary
                                    "
                                ></i>

                                <span>
                                    Reusable components
                                </span>

                            </div>


                            <div class="d-flex align-items-center gap-2">

                                <i
                                    class="
                                        bi
                                        bi-check-circle-fill
                                        text-primary
                                    "
                                ></i>

                                <span>
                                    Built for PHP
                                </span>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       HERO PREVIEW
                       ========================================= #}

                    <div class="col-lg-5">

                        <div class="card border-0 shadow-lg overflow-hidden">

                            <div
                                class="
                                    card-header
                                    bg-dark
                                    text-white
                                    border-0
                                    py-3
                                "
                            >

                                <div
                                    class="
                                        d-flex
                                        align-items-center
                                        justify-content-between
                                    "
                                >

                                    <div class="d-flex gap-2">

                                        <span
                                            class="
                                                rounded-circle
                                                bg-danger
                                            "
                                            style="
                                                width: .7rem;
                                                height: .7rem;
                                            "
                                        ></span>

                                        <span
                                            class="
                                                rounded-circle
                                                bg-warning
                                            "
                                            style="
                                                width: .7rem;
                                                height: .7rem;
                                            "
                                        ></span>

                                        <span
                                            class="
                                                rounded-circle
                                                bg-success
                                            "
                                            style="
                                                width: .7rem;
                                                height: .7rem;
                                            "
                                        ></span>

                                    </div>

                                    <small class="text-white-50">
                                        PixelFix
                                    </small>

                                </div>

                            </div>


                            <div class="card-body bg-dark text-white p-4">

                                <div class="mb-3">

                                    <span class="text-primary">
                                        $
                                    </span>

                                    <span class="text-white-50">
                                        php pixelfix
                                    </span>

                                </div>


                                <div class="mb-2">

                                    <span class="text-success">
                                        ✓
                                    </span>

                                    <span>
                                        Application initialized
                                    </span>

                                </div>


                                <div class="mb-2">

                                    <span class="text-success">
                                        ✓
                                    </span>

                                    <span>
                                        Routes registered
                                    </span>

                                </div>


                                <div class="mb-2">

                                    <span class="text-success">
                                        ✓
                                    </span>

                                    <span>
                                        Services loaded
                                    </span>

                                </div>


                                <div class="mb-4">

                                    <span class="text-success">
                                        ✓
                                    </span>

                                    <span>
                                        Application ready
                                    </span>

                                </div>


                                <div
                                    class="
                                        border-top
                                        border-secondary
                                        pt-3
                                    "
                                >

                                    <small class="text-white-50">

                                        Build.
                                        Configure.
                                        Develop.

                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        {# =================================================
           INTRODUCTION
           ================================================= #}

        <section class="py-5">

            <div class="container">

                <div class="row justify-content-center">

                    <div class="col-lg-8 text-center">

                        <span class="text-primary fw-semibold">
                            WHY PIXELFIX
                        </span>

                        <h2 class="fw-bold mt-2 mb-3">
                            Everything you need to build
                        </h2>

                        <p class="lead text-secondary mb-0">

                            PixelFix brings the essential building
                            blocks of a modern PHP application into
                            a structured and developer-friendly
                            framework.

                        </p>

                    </div>

                </div>

            </div>

        </section>


        {# =================================================
           FEATURES
           ================================================= #}

        <section class="pb-5">

            <div class="container">

                <div class="row g-4">


                    {# =========================================
                       ROUTING
                       ========================================= #}

                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            <div class="card-body p-4">

                                <i
