                                <h5 class="mt-3 fw-bold">
                                    ORM
                                </h5>

                                <p class="text-secondary mb-0">

                                    Work with models, relationships,
                                    queries, and database operations
                                    through a structured ORM layer.

                                </p>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       AUTHENTICATION
                       ========================================= #}

                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            <div class="card-body p-4">

                                <i
                                    class="
                                        bi
                                        bi-person-lock
                                        fs-1
                                        text-danger
                                    "
                                ></i>

                                <h5 class="mt-3 fw-bold">
                                    Authentication
                                </h5>

                                <p class="text-secondary mb-0">

                                    Build applications with
                                    authentication and authorization
                                    support.

                                </p>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       VIEWS
                       ========================================= #}

                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            <div class="card-body p-4">

                                <i
                                    class="
                                        bi
                                        bi-window-stack
                                        fs-1
                                        text-info
                                    "
                                ></i>

                                <h5 class="mt-3 fw-bold">
                                    Twig Views
                                </h5>

                                <p class="text-secondary mb-0">

                                    Build reusable interfaces using
                                    Twig templates and PixelFix
                                    view components.

                                </p>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       TESTING
                       ========================================= #}

                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            <div class="card-body p-4">

                                <i
