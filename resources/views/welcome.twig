                                        bi
                                        bi-signpost-split
                                        fs-1
                                        text-primary
                                    "
                                ></i>

                                <h5 class="mt-3 fw-bold">
                                    Routing
                                </h5>

                                <p class="text-secondary mb-0">

                                    Define clean and expressive
                                    application routes and connect
                                    requests to your application logic.

                                </p>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       VALIDATION
                       ========================================= #}

                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            <div class="card-body p-4">

                                <i
                                    class="
                                        bi
