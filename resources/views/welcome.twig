{% extends "layouts/app.twig" %}

{% block title %}
    PixelFix
{% endblock %}

{% block content %}


    {# =====================================================
       NAVIGATION
       ===================================================== #}

    {% include 'components/navigation/navbar.twig' with {

        brand:
            config('app.name'),

        brand_url:
            route('home'),

        expand:
            'lg',

        theme:
            'light',

        background:
            'body-tertiary',

        container:
            'container-fluid',

        id:
            'navbarSupportedContent',

        items: [

            {
                label:
                    'Home',

                url:
                    route('home'),

                active:
                    true
            },

            {
                label:
                    'About',

                url:
                    '#'
            },

            {
                label:
                    'Resources',

                children: [

                    {
                        label:
                            'Tutorial',

                        url:
                            '#'
                    },

                    {
                        label:
                            'Documentation',

                        url:
                            '#'
                    },

                    {
                        divider:
                            true
                    },

                    {
                        label:
                            'Demo Application',

                        url:
                            '#'
                    }

                ]
            },

            {
                label:
                    'Pricing',

                url:
                    '#'
            },

            {
                label:
                    'Contact Us',

                url:
                    '#'
            }

        ],

        search: {

            role:
                'search',

            type:
                'search',

            placeholder:
                'Search',

            aria_label:
                'Search',

            button_label:
                'Search',

            button_class:
                'btn-outline-success'

        }

    } %}


    {# =====================================================
       MAIN CONTENT
       ===================================================== #}

    <main class="pixelfix-page-content">


        {# =================================================
           PAGE CONTAINER
           ================================================= #}

        <div class="container py-5">

            <div class="row justify-content-center">

                <div class="col-lg-10">


                    {# =========================================
                       INTRODUCTION
                       ========================================= #}

                    <div class="text-center mb-5">

                        <h1 class="display-3 fw-bold">
                            PixelFix
                        </h1>

                        <p class="lead text-muted">

                            A modern PHP framework for building
                            web applications.

                        </p>

                    </div>


                    {# =========================================
                       FEATURES ROW ONE
                       ========================================= #}

                    <div class="row g-4">


                        {# =====================================
                           ROUTING
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-signpost-split
                                            fs-1
                                            text-primary
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        Routing
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Define clean and expressive
                                        application routes.

                                    </p>

                                </div>

                            </div>

                        </div>


                        {# =====================================
                           VALIDATION
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-shield-check
                                            fs-1
                                            text-success
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        Validation
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Validate requests with powerful
                                        built-in rules.

                                    </p>

                                </div>

                            </div>

                        </div>


                        {# =====================================
                           ORM
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-database
                                            fs-1
                                            text-warning
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        ORM
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Work with models, relationships
                                        and queries elegantly.

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    {# =========================================
                       FEATURES ROW TWO
                       ========================================= #}

                    <div class="row g-4 mt-1">


                        {# =====================================
                           AUTHENTICATION
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-person-lock
                                            fs-1
                                            text-danger
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        Authentication
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Secure authentication and
                                        authorization support.

                                    </p>

                                </div>

                            </div>

                        </div>


                        {# =====================================
                           VIEWS
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-window-stack
                                            fs-1
                                            text-info
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        Views
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Build reusable interfaces with
                                        Twig templates.

                                    </p>

                                </div>

                            </div>

                        </div>


                        {# =====================================
                           TESTING
                           ===================================== #}

                        <div class="col-md-4">

                            <div class="card h-100 border-0 shadow-sm">

                                <div class="card-body text-center">

                                    <i
                                        class="
                                            bi
                                            bi-check2-square
                                            fs-1
                                            text-secondary
                                        "
                                    ></i>

                                    <h5 class="mt-3">
                                        Testing
                                    </h5>

                                    <p class="text-muted mb-0">

                                        Test your application with
                                        the built-in testing framework.

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


    {# =====================================================
       FOOTER
       ===================================================== #}

    {% include 'components/layout/footer.twig' with {

        footer_company_name:
            config('app.name'),

        footer_company_url:
            route('home'),

        footer_right:
            ''

    } %}

{% endblock %}