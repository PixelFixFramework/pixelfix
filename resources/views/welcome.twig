                                icon:
                                    'bi bi-book',

                                content:
                                    'Documentation'

                            } %}


                            {% include 'components/forms/button.twig' with {

                                tag:
                                    'a',

                                href:
                                    '#',

                                class:
                                    'btn btn-outline-primary btn-lg px-4',

                                icon:
                                    'bi bi-play-circle',

                                content:
                                    'Explore Demo'

