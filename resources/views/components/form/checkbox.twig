{# =====================================================
   CHECKBOX COMPONENT
   ===================================================== #}

{% set checkboxName =
    name
%}

{% set checkboxLabel =
    label|default('')
%}

{% set checkboxLabelHtml =
    label_html|default(null)
%}

{% set checkboxValue =
    value|default('1')
%}

{% set checkboxRequired =
    required|default(false)
%}

{% set checkboxChecked =
    checked|default(false)
%}

{% set checkboxClass =
    class|default('')
%}

{% set checkboxDisabled =
    disabled|default(false)
%}

{% set validationMessage =
    validation_message|default(null)
%}


{# =====================================================
   VALIDATION
   ===================================================== #}

{% set fieldErrors =
    errors()[checkboxName] ?? []
%}

{% set hasError =
    has_error(checkboxName)
%}


{# =====================================================
   RESOLVE CHECKED STATE
   ===================================================== #}

{% set oldValue =
    old(
        checkboxName,
        checkboxChecked ? checkboxValue : ''
    )
%}

{% set isChecked =
    oldValue == checkboxValue
    or
    oldValue == true
%}


{# =====================================================
   INVALID MESSAGE
   ===================================================== #}

{% set invalidMessage =
    validationMessage|default(
        checkboxLabel
            ? 'Please confirm ' ~ checkboxLabel|lower ~ '.'
            : 'This field is required.'
    )
%}


{# =====================================================
   CHECKBOX
   ===================================================== #}

<div class="mb-3">

    <div class="form-check">

        <input
            id="{{ checkboxName }}"
            type="checkbox"
            name="{{ checkboxName }}"
            value="{{ checkboxValue }}"
            class="
                form-check-input
                {{ checkboxClass }}
                {% if hasError %}
                    is-invalid
                {% endif %}
            "
            {% if isChecked %}
                checked
            {% endif %}
            {% if checkboxRequired %}
                required
            {% endif %}
            {% if checkboxDisabled %}
                disabled
            {% endif %}
        >


        {# =================================================
           LABEL
           ================================================= #}

        <label
            class="form-check-label"
            for="{{ checkboxName }}"
        >

            {% if checkboxLabelHtml is not null %}

                {{ checkboxLabelHtml|raw }}

            {% else %}

                {{ checkboxLabel }}

            {% endif %}

        </label>


        {# =================================================
           VALIDATION
           ================================================= #}

        {% if hasError %}

            <div class="invalid-feedback d-block">

                {{ error(checkboxName) }}

            </div>

        {% else %}

            <div class="invalid-feedback">

                {{ invalidMessage }}

            </div>

        {% endif %}

    </div>

</div>