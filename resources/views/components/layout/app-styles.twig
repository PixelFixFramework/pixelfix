    {% endif %}

    <link
        rel="stylesheet"
        href="{{ asset('css/zebra/' ~ zebra_theme ~ '/zebra_dialog.min.css') }}"
    >


    {# =====================================================
       OVERLAYSCROLLBARS
       ===================================================== #}

    <link
        rel="stylesheet"
        href="{{ asset('css/overlayscrollbars.min.css') }}"
    >


