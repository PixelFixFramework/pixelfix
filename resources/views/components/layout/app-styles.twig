        href="{{ asset('css/bootstrap.min.css') }}"
    >


    {# =====================================================
       BOOTSTRAP ICONS
       ===================================================== #}

    <link
        rel="stylesheet"
        href="{{ asset('css/bootstrap-icons.min.css') }}"
    >


