{# =====================================================
   PIXELFIX APPLICATION FOOTER
   ===================================================== #}

{% set footerCurrentYear =
    "now"|date('Y')
%}

{% set footerCompanyName =
    footer_company_name|default(config('app.name'))
%}

{% set footerCompanyUrl =
    footer_company_url|default('#')
%}

{% set footerRight =
    footer_right|default(null)
%}

{% set container =
    container|default('container-fluid')
%}


{# =====================================================
   FOOTER
   ===================================================== #}

<footer class="pixelfix-footer">

    <div class="{{ container }}">

        <div class="pixelfix-footer-content">


            {# =================================================
               COPYRIGHT
               ================================================= #}

            <div class="pixelfix-footer-copyright">

                <strong>

                    Copyright &copy;

                    {{ footerCurrentYear }}

                    <a
                        href="{{ footerCompanyUrl }}"
                        class="text-decoration-none"
                    >{{ footerCompanyName }}</a>.

                </strong>

                <span>
                    All rights reserved.
                </span>

            </div>


            {# =================================================
               RIGHT CONTENT
               ================================================= #}

            {% if footerRight %}

                <div class="pixelfix-footer-right">

                    {{ footerRight|raw }}

                </div>

            {% endif %}


        </div>

    </div>

</footer>