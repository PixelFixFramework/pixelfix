{# =====================================================
   PIXELFIX CARD COMPONENT
   ===================================================== #}

{% set cardTitle = title|default(null) %}
{% set cardSubtitle = subtitle|default(null) %}
{% set cardContent = content|default('') %}
{% set cardFooter = footer|default(null) %}

{% set cardClass = class|default('') %}
{% set cardId = id|default('') %}
{% set cardRole = role|default('') %}
{% set cardAriaLabel = aria_label|default('') %}
{% set cardAriaLabelledby = aria_labelledby|default('') %}
{% set cardAriaDescribedby = aria_describedby|default('') %}

{% set cardBodyClass = body_class|default('') %}
{% set cardTitleClass = title_class|default('') %}
{% set cardTitleId = title_id|default('') %}
{% set cardSubtitleClass = subtitle_class|default('') %}
{% set cardSubtitleId = subtitle_id|default('') %}
{% set cardFooterClass = footer_class|default('') %}

{% set cardContentPartial = content_partial|default('') %}
{% set cardFooterPartial = footer_partial|default('') %}

{% set cardEscapeContent = escape_content|default(false) %}
{% set cardEscapeFooter = escape_footer|default(false) %}

{% set cardTitleTag = title_tag|default('h5') %}
{% set cardSubtitleTag = subtitle_tag|default('h6') %}

{% set cardHeadingTags = [
    'h1',
    'h2',
    'h3',
    'h4',
    'h5',
    'h6',
] %}

{% if cardTitleTag not in cardHeadingTags %}

    {% set cardTitleTag = 'h5' %}

{% endif %}

{% if cardSubtitleTag not in cardHeadingTags %}

    {% set cardSubtitleTag = 'h6' %}

{% endif %}


{# =====================================================
   FOOTER VISIBILITY
   ===================================================== #}

{% set cardShowFooter =
    (cardFooter is not null and cardFooter != '')
    or cardFooterPartial
%}

{% if show_footer is defined and not show_footer %}

    {% set cardShowFooter = false %}

{% endif %}


{# =====================================================
   CARD
   ===================================================== #}

<div
    {% if cardId %}
        id="{{ cardId }}"
    {% endif %}
    {% if cardRole %}
        role="{{ cardRole }}"
    {% endif %}
    {% if cardAriaLabel %}
        aria-label="{{ cardAriaLabel }}"
    {% endif %}
    {% if cardAriaLabelledby %}
        aria-labelledby="{{ cardAriaLabelledby }}"
    {% endif %}
    {% if cardAriaDescribedby %}
        aria-describedby="{{ cardAriaDescribedby }}"
    {% endif %}
    class="card {{ cardClass }}"
>

    {# Allow embed callers to supply the complete card content while retaining #}
    {# the default reusable card body for ordinary include callers. #}
    {% block card_content %}
    <div class="card-body {{ cardBodyClass }}">

        {% if cardTitle is not null and cardTitle != '' %}

            <{{ cardTitleTag }}
                {% if cardTitleId %}
                    id="{{ cardTitleId }}"
                {% endif %}
                class="card-title {{ cardTitleClass }}"
            >

                {{ cardTitle }}

            </{{ cardTitleTag }}>

        {% endif %}

        {% if cardSubtitle is not null and cardSubtitle != '' %}

            <{{ cardSubtitleTag }}
                {% if cardSubtitleId %}
                    id="{{ cardSubtitleId }}"
                {% endif %}
                class="card-subtitle mb-3 text-muted {{ cardSubtitleClass }}"
            >

                {{ cardSubtitle }}

            </{{ cardSubtitleTag }}>

        {% endif %}

        {% if cardContentPartial %}

            {% include
                cardContentPartial
                with {
                    cardTitle:
                        cardTitle,

                    cardSubtitle:
                        cardSubtitle,

                    cardContent:
                        cardContent,

                    cardFooter:
                        cardFooter,
                }
                only
            %}

        {% elseif cardEscapeContent %}

            {{ cardContent|e }}

        {% else %}

            {#
                Backward compatibility: content is trusted HTML by default.
                Set escape_content to true for plain text, or use a partial
                for structured, application-authored markup.
            #}

            {{ cardContent|raw }}

        {% endif %}

    </div>
    {% endblock %}

    {% if cardShowFooter %}

        {% if cardFooterPartial %}

            {% include
                cardFooterPartial
                with {
                    cardTitle:
                        cardTitle,

                    cardSubtitle:
                        cardSubtitle,

                    cardContent:
                        cardContent,

                    cardFooter:
                        cardFooter,
                }
                only
            %}

        {% else %}

            <div class="card-footer {{ cardFooterClass }}">

                {% if cardEscapeFooter %}

                    {{ cardFooter|e }}

                {% else %}

                    {# Footer retains the legacy trusted-HTML default. #}

                    {{ cardFooter|raw }}

                {% endif %}

            </div>

        {% endif %}

    {% endif %}

</div>