{# =====================================================
   PIXELFIX HEADER - THEME
   ===================================================== #}

<li class="pixelfix-nav-item dropdown">

    <a
        class="pixelfix-nav-link"
        href="#"
        id="pixelfix-theme-menu"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        aria-label="Toggle color scheme"
    >

        <i
            class="bi bi-sun-fill"
            data-pixelfix-theme-icon="light"
            aria-hidden="true"
        ></i>


        <i
            class="
                bi
                bi-moon-fill
                d-none
            "
            data-pixelfix-theme-icon="dark"
            aria-hidden="true"
        ></i>


        <i
            class="
                bi
                bi-circle-half
                d-none
            "
            data-pixelfix-theme-icon="auto"
            aria-hidden="true"
        ></i>

    </a>


    <ul
        class="
            dropdown-menu
            dropdown-menu-end
            pixelfix-theme-menu
        "
        aria-labelledby="pixelfix-theme-menu"
    >

        <li>

            <button
                type="button"
                class="
                    dropdown-item
                    d-flex
                    align-items-center
                "
                data-pixelfix-theme-value="light"
                aria-pressed="false"
            >

                <i
                    class="
                        bi
                        bi-sun-fill
                        me-2
                    "
                    aria-hidden="true"
                ></i>

                Light


                <i
                    class="
                        bi
                        bi-check-lg
                        ms-auto
                        d-none
                    "
                    aria-hidden="true"
                ></i>

            </button>

        </li>


        <li>

            <button
                type="button"
                class="
                    dropdown-item
                    d-flex
                    align-items-center
                "
                data-pixelfix-theme-value="dark"
                aria-pressed="false"
            >

                <i
                    class="
                        bi
                        bi-moon-fill
                        me-2
                    "
                    aria-hidden="true"
                ></i>

                Dark


                <i
                    class="
                        bi
                        bi-check-lg
                        ms-auto
                        d-none
                    "
                    aria-hidden="true"
                ></i>

            </button>

        </li>


        <li>

            <button
                type="button"
                class="
                    dropdown-item
                    d-flex
                    align-items-center
                "
                data-pixelfix-theme-value="auto"
                aria-pressed="false"
            >

                <i
                    class="
                        bi
                        bi-circle-half
                        me-2
                    "
                    aria-hidden="true"
                ></i>

                Auto


                <i
                    class="
                        bi
                        bi-check-lg
                        ms-auto
                        d-none
                    "
                    aria-hidden="true"
                ></i>

            </button>

        </li>

    </ul>

</li>