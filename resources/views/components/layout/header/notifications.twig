{# =====================================================
   PIXELFIX HEADER - NOTIFICATIONS
   ===================================================== #}

{% set notificationItems =
    notifications|default([])
%}

{% set notificationCount =
    notification_count|default(notificationItems|length)
%}

{% set notificationsUrl =
    notifications_url|default('#')
%}

{% set notificationsFooterText =
    notifications_footer_text|default(
        'See All Notifications'
    )
%}


<li class="pixelfix-nav-item dropdown">

    <a
        class="pixelfix-nav-link"
        data-bs-toggle="dropdown"
        href="#"
        role="button"
        aria-expanded="false"
        aria-label="Notifications: {{ notificationCount }} unread"
    >

        <i
            class="bi bi-bell-fill"
            aria-hidden="true"
        ></i>


        {% if notificationCount > 0 %}

            <span
                class="
                    pixelfix-navbar-badge
                    badge
                    text-bg-warning
                "
            >

                {{ notificationCount }}

            </span>

        {% endif %}

    </a>


    <div
        class="
            dropdown-menu
            dropdown-menu-lg
            dropdown-menu-end
        "
    >

        {# =================================================
           NOTIFICATION HEADER
           ================================================= #}

        <span
            class="
                dropdown-item
                dropdown-header
            "
        >

            {{ notificationCount }}
            Notifications

        </span>


        {% if notificationItems is not empty %}

            <div class="dropdown-divider"></div>


            {# =================================================
               NOTIFICATIONS
               ================================================= #}

            {% for notification in notificationItems %}

                <a
                    href="{{ notification.url|default('#') }}"
                    class="dropdown-item"
                >

                    {% if notification.icon|default(null) %}

                        <i
                            class="
                                {{ notification.icon }}
                                me-2
                            "
                            aria-hidden="true"
                        ></i>

                    {% endif %}


                    {{ notification.text|default('Notification') }}


                    {% if notification.time|default(null) %}

                        <span
                            class="
                                float-end
                                text-secondary
                                fs-7
                            "
                        >

                            {{ notification.time }}

                        </span>

                    {% endif %}

                </a>


                {% if not loop.last %}

                    <div class="dropdown-divider"></div>

                {% endif %}

            {% endfor %}

        {% else %}

            <span
                class="
                    dropdown-item
                    text-muted
                "
            >

                No notifications

            </span>

        {% endif %}


        {# =================================================
           NOTIFICATIONS FOOTER
           ================================================= #}

        {% include
            'components/form/button.twig'
            with {
                tag:
                    'a',

                href:
                    notificationsUrl,

                class:
                    '
                        dropdown-item
                        dropdown-footer
                    ',

                content:
                    notificationsFooterText
            }
            only
        %}

    </div>

</li>