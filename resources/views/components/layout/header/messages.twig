{# =====================================================
   PIXELFIX HEADER - MESSAGES
   ===================================================== #}

{% set messages =
    messages|default([])
%}

{% set messageCount =
    message_count|default(messages|length)
%}

{% set messagesFooterText =
    messages_footer_text|default(
        'See All Messages'
    )
%}

{% set messageBadgeTypes = [
    'primary',
    'secondary',
    'success',
    'danger',
    'warning',
    'info',
    'dark'
] %}


<li class="pixelfix-nav-item dropdown">

    <a
        href="#"
        class="pixelfix-nav-link"
        data-bs-toggle="dropdown"
        role="button"
        aria-expanded="false"
        aria-label="Messages: {{ messageCount }} unread"
    >

        <i
            class="bi bi-chat-left-text"
            aria-hidden="true"
        ></i>


        {# =================================================
           MESSAGE COUNT
           ================================================= #}

        {% if messageCount > 0 %}

            <span
                class="
                    pixelfix-navbar-badge
                    badge
                    text-bg-danger
                "
            >

                {{ messageCount }}

            </span>

        {% endif %}

    </a>


    {# =================================================
       MESSAGE DROPDOWN
       ================================================= #}

    <div
        class="
            dropdown-menu
            dropdown-menu-end
            pixelfix-messages-menu
        "
    >

        {% for message in messages %}

            <a
                href="{{ message.url|default('#') }}"
                class="
                    pixelfix-message-item
                    dropdown-item
                "
            >

                <span
                    class="
                        pixelfix-message-avatar

                        {% if message.avatar|default(null) %}
                            pixelfix-message-avatar-image
                        {% endif %}
                    "
                >

                    {% if message.avatar|default(null) %}

                        <img
                            src="{{ message.avatar }}"
                            alt="{{ message.name|default('User') }}"
                        >

                    {% else %}

                        {% set badgeType =
                            message.badge_type|default(
                                random(messageBadgeTypes)
                            )
                        %}

                        {% include
                            'components/feedback/badge.twig'
                            with {
                                type:
                                    badgeType,

                                text:
                                    message.initials|default(
                                        message.name|default('U')
                                            |first
                                            |upper
                                    )
                            }
                            only
                        %}

                    {% endif %}

                </span>


                <span class="pixelfix-message-content">

                    <span class="pixelfix-message-name">
                        {{ message.name|default('Unknown User') }}
                    </span>

                    <span class="pixelfix-message-preview">
                        {{ message.preview|default('') }}
                    </span>

                    <span class="pixelfix-message-time">

                        <i
                            class="bi bi-clock-fill"
                            aria-hidden="true"
                        ></i>

                        {{ message.time|default('') }}

                    </span>

                </span>


                <i
                    class="
                        bi
                        bi-star-fill
                        pixelfix-message-star
                        {{ message.star_type|default('text-secondary') }}
                    "
                    aria-hidden="true"
                ></i>

            </a>

        {% endfor %}


        {% if messages is empty %}

            <span
                class="
                    pixelfix-message-item
                    dropdown-item
                    text-muted
                "
            >
                No messages
            </span>

        {% endif %}


        {% include
            'components/form/button.twig'
            with {
                tag:
                    'a',

                href:
                    messages_url|default('#'),

                class:
                    '
                        pixelfix-messages-footer
                        dropdown-item
                    ',

                content:
                    messagesFooterText
            }
            only
        %}

    </div>

</li>