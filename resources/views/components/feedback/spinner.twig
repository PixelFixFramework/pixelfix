{# =====================================================
   SPINNER COMPONENT
   ===================================================== #}

{% set spinnerType = type|default('primary') %}
{% set spinnerSize = size|default(null) %}
{% set spinnerLabel = label|default('Loading...') %}

<div
    class="
        spinner-border
        text-{{ spinnerType }}
        {% if spinnerSize == 'sm' %}
            spinner-border-sm
        {% endif %}
    "
    role="status"
>

    <span class="visually-hidden">

        {{ spinnerLabel }}

    </span>

</div>