{# =====================================================
   OFFCANVAS COMPONENT
   ===================================================== #}

{% set offcanvasId = id %}
{% set offcanvasTitle = title|default('Menu') %}
{% set offcanvasContent = content|default('') %}
{% set offcanvasPlacement = placement|default('start') %}
{% set offcanvasBackdrop = backdrop|default(true) %}
{% set offcanvasScroll = scroll|default(false) %}

{# =====================================================
   VALIDATE PLACEMENT
   ===================================================== #}

{% set placementClass = {

    'start': 'offcanvas-start',

    'end': 'offcanvas-end',

    'top': 'offcanvas-top',

    'bottom': 'offcanvas-bottom'

}[offcanvasPlacement]|default('offcanvas-start') %}

{# =====================================================
   OFFCANVAS
   ===================================================== #}

<div
    class="
        offcanvas
        {{ placementClass }}
    "
    tabindex="-1"
    id="{{ offcanvasId }}"
    aria-labelledby="{{ offcanvasId }}Label"
    data-bs-scroll="{{ offcanvasScroll ? 'true' : 'false' }}"
    data-bs-backdrop="{{ offcanvasBackdrop ? 'true' : 'false' }}"
>

    {# =============================================
       HEADER
       ============================================= #}

    <div class="offcanvas-header">

        <h5
            class="offcanvas-title"
            id="{{ offcanvasId }}Label"
        >

            {{ offcanvasTitle }}

        </h5>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
        ></button>

    </div>

    {# =============================================
       BODY
       ============================================= #}

    <div class="offcanvas-body">

        {{ offcanvasContent|raw }}

    </div>

</div>