{# =====================================================
   BREADCRUMB COMPONENT
   ===================================================== #}

{% set items = items|default([]) %}

<nav aria-label="breadcrumb">

    <ol class="breadcrumb">

        {% for item in items %}

            {% if loop.last %}

                <li
                    class="breadcrumb-item active"
                    aria-current="page"
                >

                    {{ item.label }}

                </li>

            {% else %}

                <li class="breadcrumb-item">

                    <a href="{{ item.url }}">

                        {{ item.label }}

                    </a>

                </li>

            {% endif %}

        {% endfor %}

    </ol>

</nav>