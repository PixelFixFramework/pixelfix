{# =====================================================
   CHECKBOX COMPONENT
   ===================================================== #}

{% set checkboxName = name %}
{% set checkboxLabel = label|default('') %}
{% set checkboxValue = value|default('1') %}
{% set checkboxRequired = required|default(false) %}
{% set checkboxChecked = checked|default(false) %}
{% set checkboxClass = class|default('') %}
{% set checkboxDisabled = disabled|default(false) %}

{% set fieldErrors = errors()[checkboxName] ?? [] %}
{% set hasError = has_error(checkboxName) %}

{% set oldValue =
    old(
        checkboxName,
        checkboxChecked ? checkboxValue : ''
    )
%}

{% set isChecked =
    oldValue == checkboxValue
    or
    oldValue == true
%}

{% set invalidMessage =
    validation_message|default(
        checkboxLabel
            ? 'Please confirm ' ~ checkboxLabel|lower ~ '.'
            : 'This field is required.'
    )
%}

<div class="mb-3">

    <div class="form-check">

        <input
            id="{{ checkboxName }}"
            type="checkbox"
            name="{{ checkboxName }}"
            value="{{ checkboxValue }}"
            class="
                form-check-input
                {{ checkboxClass }}
                {% if hasError %}
                    is-invalid
                {% endif %}
            "
            {% if isChecked %}
                checked
            {% endif %}
            {% if checkboxRequired %}
                required
            {% endif %}
            {% if checkboxDisabled %}
                disabled
            {% endif %}
        >

        <label
            class="form-check-label"
            for="{{ checkboxName }}"
        >
            {{ checkboxLabel }}
        </label>

        {% if hasError %}

            <div class="invalid-feedback d-block">
                {{ error(checkboxName) }}
            </div>

        {% else %}

            <div class="invalid-feedback">
                {{ invalidMessage }}
            </div>

        {% endif %}

    </div>

</div>