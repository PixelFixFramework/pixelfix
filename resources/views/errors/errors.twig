<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        {% block title %}
            {{ code|default('Error') }} - {{ title|default('Error') }}
        {% endblock %}
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;

            background: #f8f9fa;
            color: #212529;

            padding: 3rem;
        }

        .container {

            width: 100%;
            max-width: 1100px;

            margin: 0 auto;
        }

        .error {

            background: #ffffff;

            border: 1px solid #dee2e6;
            border-radius: 0.5rem;

            padding: 2rem;

            box-shadow:
                0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .code {

            font-size: 5rem;
            line-height: 1;

            font-weight: 700;

            margin-bottom: 1rem;
        }

        h1 {

            margin: 0;

            font-size: 2rem;
            line-height: 1.25;
        }

        .message {

            margin-top: 1rem;

            font-size: 1.1rem;
            line-height: 1.6;
        }

        .debug {

            margin-top: 2rem;

            padding: 1.5rem;

            background: #212529;

            color: #f8f9fa;

            border-radius: 0.5rem;

            overflow-x: auto;
        }

        .debug h2 {

            margin: 0 0 1rem 0;

            font-size: 1.25rem;
        }

        .debug-section {

            margin-top: 1.5rem;
        }

        .debug-section:first-of-type {
            margin-top: 0;
        }

        .debug-label {

            display: block;

            margin-bottom: 0.35rem;

            font-size: 0.8rem;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.05em;

            color: #adb5bd;
        }

        .debug-value {

            margin: 0;

            color: #f8f9fa;

            word-break: break-word;
        }

        .debug pre {

            margin: 0;

            padding: 1rem;

            background: #111315;

            border: 1px solid #343a40;
            border-radius: 0.375rem;

            color: #f8f9fa;

            font-family:
                Consolas,
                Monaco,
                "Courier New",
                monospace;

            font-size: 0.875rem;

            line-height: 1.6;

            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .trace {

            white-space: pre-wrap;
        }

        @media (max-width: 768px) {

            body {
                padding: 1rem;
            }

            .error {
                padding: 1.25rem;
            }

            .code {
                font-size: 4rem;
            }

            h1 {
                font-size: 1.5rem;
            }

        }

    </style>

</head>

<body>

<div class="container">

    <div class="error">

        {# =================================================
           ERROR CODE
           ================================================= #}

        <div class="code">

            {% block code %}
                {{ code|default('500') }}
            {% endblock %}

        </div>

        {# =================================================
           ERROR HEADING
           ================================================= #}

        <h1>

            {% block heading %}
                {{ title|default('Server Error') }}
            {% endblock %}

        </h1>

        {# =================================================
           ERROR MESSAGE
           ================================================= #}

        <div class="message">

            {% block message %}
                {{ message|default('An unexpected error occurred.') }}
            {% endblock %}

        </div>

        {# =================================================
           DEBUG INFORMATION
           ================================================= #}

        {% if debug|default(false) and debug_info|default(null) %}

            <div class="debug">

                <h2>
                    Debug Information
                </h2>

                {# =========================================
                   EXCEPTION CLASS
                   ========================================= #}

                {% if debug_info.class|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Exception
                        </span>

                        <p class="debug-value">
                            {{ debug_info.class }}
                        </p>

                    </div>

                {% endif %}

                {# =========================================
                   MESSAGE
                   ========================================= #}

                {% if debug_info.message|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Message
                        </span>

                        <p class="debug-value">
                            {{ debug_info.message }}
                        </p>

                    </div>

                {% endif %}

                {# =========================================
                   FILE
                   ========================================= #}

                {% if debug_info.file|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            File
                        </span>

                        <p class="debug-value">
                            {{ debug_info.file }}
                        </p>

                    </div>

                {% endif %}

                {# =========================================
                   LINE
                   ========================================= #}

                {% if debug_info.line is defined %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Line
                        </span>

                        <p class="debug-value">
                            {{ debug_info.line }}
                        </p>

                    </div>

                {% endif %}

                {# =========================================
                   STACK TRACE
                   ========================================= #}

                {% if debug_info.trace|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Stack Trace
                        </span>

                        <pre class="trace">{{ debug_info.trace }}</pre>

                    </div>

                {% endif %}

                {# =========================================
                   REQUEST INFORMATION
                   ========================================= #}

                {% if debug_info.request|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Request
                        </span>

                        <pre>{{ debug_info.request|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>

                    </div>

                {% endif %}

                {# =========================================
                   CONTEXT
                   ========================================= #}

                {% if debug_info.context|default(null) %}

                    <div class="debug-section">

                        <span class="debug-label">
                            Context
                        </span>

                        <pre>{{ debug_info.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>

                    </div>

                {% endif %}

            </div>

        {% endif %}

    </div>

</div>

</body>

</html>