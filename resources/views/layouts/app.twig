{# The application layout composes the document through a layout component. #}
{% set pageTitle %}
    {% block title %}
        {{ config('app.name') }}
    {% endblock %}
{% endset %}

{% set pageContent %}
    {% block content %}{% endblock %}
{% endset %}

{% include 'components/layout/document.twig' with {
    page_title: pageTitle|trim,
    page_content: pageContent
} %}
